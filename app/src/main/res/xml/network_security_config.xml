<?xml version="1.0" encoding="utf-8"?>
<!--
  Jellyfin is commonly self-hosted on a LAN without TLS. Cleartext is therefore
  allowed by base config; HTTPS endpoints still use the platform trust store.
  User-installed CAs are trusted so private/self-signed Jellyfin setups work.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
